<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Restore the database only through the in-app Google Drive flow. -->
        <exclude domain="file" path="autoubc" />
    </cloud-backup>
    <device-transfer>
        <!-- Avoid copying an older local database during device migration. -->
        <exclude domain="file" path="autoubc" />
    </device-transfer>
</data-extraction-rules>
